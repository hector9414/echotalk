# Puerto del servidor (HTTP). Los oyentes se conectan a este puerto en la
# IP LAN de esta maquina; el presentador puede entrar por localhost aqui.
PORT=3000

# HTTPS esta activado por defecto: es lo que permite usar OTRO dispositivo
# (ej. tu celular) como presentador cuando esta maquina no tiene microfono -
# el navegador exige HTTPS o localhost para dar acceso al microfono, y una IP
# de LAN por HTTP plano no alcanza. El certificado es autofirmado (se genera
# solo, no requiere configuracion) asi que el navegador va a mostrar una
# advertencia de "conexion no privada" la primera vez - es normal, acéptala.
# Pon ENABLE_HTTPS=false para desactivarlo (el presentador entonces solo
# puede usar esta misma maquina, por localhost).
ENABLE_HTTPS=true
HTTPS_PORT=3443

# Proveedor de motor de voz/traduccion/transcripcion.
# 'google' (nube, de pago, mejor calidad/latencia) o 'local' (gratis, sin
# internet en el evento, pero con subtitulos por bloques en vez de palabra
# por palabra y traduccion/voz de menor calidad - ver "Proveedor local" en
# SPEC.md antes de usarlo, y las variables LOCAL_*/PIPER_* mas abajo).
PROVIDER=google

# Ruta al archivo JSON de la cuenta de servicio de Google Cloud, con los
# roles de Speech-to-Text, Cloud Translation y Text-to-Speech habilitados.
# Alternativa para desarrollo local: correr `gcloud auth application-default
# login` y dejar esta variable vacia.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# ID del proyecto de Google Cloud (opcional si ya viene incluido en las
# credenciales de la cuenta de servicio).
GOOGLE_CLOUD_PROJECT_ID=

# Motor de texto-a-voz (la narracion que escucha la audiencia). 'google'
# reusa las credenciales de Google de arriba. 'elevenlabs' usa la API de
# ElevenLabs en su lugar (mejor calidad de voz, mas costosa) y requiere las 3
# variables ELEVENLABS_* de abajo. 'piper' usa el motor local (requiere
# PIPER_MODEL_DIR mas abajo). El reconocimiento de voz y la traduccion los
# define PROVIDER, no esta variable - son independientes entre si.
# Si PROVIDER=local y no pones TTS_PROVIDER, el default pasa a ser 'piper'
# (no 'google'), para que un setup "local" no llame a la nube sin querer.
TTS_PROVIDER=google

# --- Solo si TTS_PROVIDER=elevenlabs ---

# Tu API key de ElevenLabs (pestaña "Profile" en elevenlabs.io, o
# Settings > API Keys). Nunca la subas al repo.
ELEVENLABS_API_KEY=

# El voice_id de la voz a usar (se ve en la pestaña "Voices" de ElevenLabs,
# o vía GET /v1/voices). Una sola voz habla todos los idiomas configurados
# en LANGUAGES - los modelos multilingues de ElevenLabs detectan el idioma
# por el texto, no por un codigo de idioma como Google.
ELEVENLABS_VOICE_ID=

# model_id a usar. eleven_multilingual_v2 es el modelo multilingue estable
# de referencia; ElevenLabs tiene variantes mas rapidas/economicas (flash,
# turbo) - revisa tu dashboard o GET /v1/models para el id exacto vigente.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Solo si PROVIDER=local (y/o TTS_PROVIDER=piper) ---
# Ninguno de estos procesos lo instala o administra esta app - los corres tu
# por tu cuenta, igual que el SDK de Google Cloud. Ver "Proveedor local" en
# SPEC.md para instrucciones de instalacion y las limitaciones de calidad.

# URL de un servidor compatible con whisper.cpp (examples/server), ej.
# `./server -m ggml-base.bin --port 8178`.
LOCAL_STT_URL=http://127.0.0.1:8178

# Los motores tipo Whisper no dan resultados parciales nativos (no hay
# streaming real) - este intervalo controla cada cuanto se re-transcribe el
# audio acumulado para simular un subtitulo "interino".
LOCAL_STT_CHUNK_INTERVAL_MS=2000

# Duracion de silencio (ms) para considerar que el orador termino una frase.
LOCAL_STT_SILENCE_MS=800

# Umbral de energia RMS (PCM16, rango 0-32767) para considerar un bloque de
# audio como silencio - depende del microfono/ambiente, ajustalo si el final
# de frase tarda demasiado o se corta a mitad de palabra.
LOCAL_STT_SILENCE_RMS_THRESHOLD=500

# URL de un servidor LibreTranslate, ej. `libretranslate --port 5000`.
LOCAL_TRANSLATE_URL=http://127.0.0.1:5000

# Binario de Piper (https://github.com/OHF-Voice/piper1-gpl). Por defecto
# asume que 'piper' esta en el PATH del sistema.
PIPER_BINARY_PATH=piper

# Carpeta con un archivo <languageId>.onnx (ej. es-ES.onnx, en-US.onnx) por
# cada idioma de destino que vayas a usar. Requerido si TTS_PROVIDER=piper.
PIPER_MODEL_DIR=
